# Copy this file to .env and fill in values. .env is gitignored.

# --- Database ---
# Dev default: SQLite file. Switch to a postgres URL later, e.g.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/fundradar
DATABASE_URL=sqlite:///./fundradar.db

# --- LLM provider: gemini | ollama | mock ---
LLM_PROVIDER=mock

# Google Gemini (free tier: 1500 req/day, no card). Get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (fully local/free). Install from https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
