# Copy this file to .env and fill in values. .env is gitignored.

# --- Database ---
# Dev default: SQLite file. Switch to a postgres URL later, e.g.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/fundradar
DATABASE_URL=sqlite:///./fundradar.db

# --- LLM provider: auto | gemini | groq | ollama | mock ---
# "auto" tries Gemini -> Groq -> Ollama in order, so extraction keeps working
# even when one provider's daily quota runs out. (recommended)
LLM_PROVIDER=auto

# Google Gemini (free tier, no card). Get a key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (free, very fast — recommended fallback). Key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (fully local/free, last resort). Install from https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Authentication (JWT) ---
# MUST be overridden in production with a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_MINUTES=60
REMEMBER_ME_DAYS=30
# Set to true in production so the auth cookie is only sent over HTTPS.
# Keep it false for local development (http://127.0.0.1), or the browser will
# refuse to store your login cookie.
COOKIE_SECURE=false

# --- Google Sign-In (optional) ---
# Leave blank and the "Continue with Google" button simply never appears —
# email/password login is unaffected. To turn it on, create a free OAuth
# Client ID (Application type: "Web application") at
#   https://console.cloud.google.com/apis/credentials
# and paste it below. Step-by-step guide: GOOGLE_SIGNIN_SETUP.md
# Only the Client ID is needed; there is no client secret in this flow, and the
# Client ID is public by design (it is sent to the browser).
GOOGLE_CLIENT_ID=
