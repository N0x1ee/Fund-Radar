<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>FundRadar — Funding Opportunity Intelligence</title>
<style>
  :root{
    --bg:#eef3f9; --card:#ffffff; --ink:#0f2540; --muted:#64798f; --line:#e6edf5;
    --brand:#2563eb; --brand-d:#1d4ed8; --brand-soft:#eef4ff;
    --green:#059669; --green-d:#047857; --green-soft:#e7f7f0;
    --open:#047857; --open-bg:#d6f5e6;
    --closed:#64748b; --closed-bg:#eef2f7; --unk:#b45309; --unk-bg:#fef3c7;
    --shadow:0 1px 2px rgba(15,37,64,.04),0 10px 30px -18px rgba(15,37,64,.22);
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:radial-gradient(1200px 500px at 80% -10%,#dceaff 0,transparent 60%),var(--bg);
    color:var(--ink);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}

  /* ---- top nav ---- */
  .nav{position:sticky;top:0;z-index:30;background:rgba(255,255,255,.9);
    backdrop-filter:saturate(180%) blur(8px);border-bottom:1px solid var(--line)}
  .nav-in{max-width:1180px;margin:0 auto;padding:12px 22px;display:flex;align-items:center;gap:14px}
  .brand{display:flex;align-items:center;gap:11px;font-weight:800;font-size:17px;letter-spacing:-.2px}
  .logo{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--brand),var(--green));
    display:grid;place-items:center;color:#fff;box-shadow:0 4px 12px -4px rgba(37,99,235,.5)}
  .brand small{display:block;font-weight:500;font-size:11px;color:var(--muted);letter-spacing:0}
  .nav-spacer{flex:1}
  .gbtn{display:inline-flex;align-items:center;gap:9px;background:#fff;border:1px solid var(--line);
    padding:8px 14px;border-radius:9px;font-weight:600;font-size:13px;cursor:pointer;color:var(--ink);
    transition:.15s;text-decoration:none}
  .gbtn:hover{border-color:#cdd9e8;box-shadow:var(--shadow)}

  .wrap{max-width:1180px;margin:0 auto;padding:24px 22px 70px}

  /* ---- gradient hero ---- */
  .hero{position:relative;overflow:hidden;border-radius:20px;padding:26px 28px;color:#fff;margin-bottom:22px;
    background:linear-gradient(115deg,#1e40af 0%,#2563eb 42%,#0e9f6e 115%);
    box-shadow:0 18px 40px -20px rgba(37,99,235,.65)}
  .hero::after{content:"";position:absolute;right:-60px;top:-70px;width:240px;height:240px;border-radius:50%;
    background:radial-gradient(circle,rgba(255,255,255,.18),transparent 70%)}
  .hero::before{content:"";position:absolute;right:90px;bottom:-90px;width:180px;height:180px;border-radius:50%;
    background:radial-gradient(circle,rgba(16,185,129,.35),transparent 70%)}
  .hero h1{margin:0;font-size:26px;letter-spacing:-.5px;position:relative}
  .hero p{margin:7px 0 0;opacity:.92;max-width:560px;position:relative}
  .hstats{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px}
  .hstat{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.22);border-radius:14px;
    padding:15px 16px;backdrop-filter:blur(3px)}
  .hstat .ic{opacity:.9;margin-bottom:9px}
  .hstat .n{font-size:28px;font-weight:800;letter-spacing:-1px;line-height:1}
  .hstat .l{font-size:12px;color:rgba(255,255,255,.86);font-weight:600;margin-top:4px}

  /* ---- ask card ---- */
  .ask{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;
    margin-bottom:22px;box-shadow:var(--shadow);border-top:3px solid var(--green)}
  .ask-h{font-weight:800;font-size:15px;display:flex;align-items:center;gap:8px}
  .ask-sub{font-size:12.5px;color:var(--muted);margin:3px 0 13px}
  .ask-row{display:flex;gap:10px}
  .ask-row input{flex:1;padding:11px 14px;border:1px solid var(--line);border-radius:10px;font-size:14px;outline:none}
  .ask-row input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(37,99,235,.12)}
  .ask-row button{padding:11px 20px;border:none;background:var(--brand);color:#fff;border-radius:10px;
    font-weight:700;cursor:pointer;transition:.15s}
  .ask-row button:hover{background:var(--brand-d)}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
  .chip{font-size:12px;padding:7px 13px;background:var(--brand-soft);color:var(--brand-d);
    border:1px solid #dbe6ff;border-radius:999px;cursor:pointer;transition:.15s}
  .chip:hover{background:#e2ebff;transform:translateY(-1px)}
  /* ---- chat thread (conversational bubbles) ---- */
  .chatthread{display:flex;flex-direction:column;gap:10px;margin:4px 0 14px;
    max-height:360px;overflow-y:auto;padding:4px 2px}
  .cbubble{border-radius:13px;padding:10px 14px;font-size:13.5px;line-height:1.55;
    max-width:88%;word-wrap:break-word;animation:cb .18s ease-out}
  @keyframes cb{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
  .cbubble.q{background:var(--brand);color:#fff;margin-left:auto;border-bottom-right-radius:4px}
  .cbubble.a{background:#fff;border:1px solid var(--line);color:var(--ink);
    border-bottom-left-radius:4px;box-shadow:0 1px 2px rgba(15,37,64,.04)}
  .cbubble.a strong{color:var(--green-d)}
  .cbubble.a p{margin:0 0 6px}
  .cbubble.a p:last-child{margin-bottom:0}
  .cbubble.a .chatlist{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-direction:column;gap:7px}
  .cbubble.a .chatlist li{position:relative;padding-left:16px}
  .cbubble.a .chatlist li::before{content:"";position:absolute;left:2px;top:8px;width:6px;height:6px;
    border-radius:50%;background:var(--green)}
  .cbubble.a a{color:var(--brand);font-weight:600;text-decoration:none}
  .cbubble.a a:hover{text-decoration:underline}
  .cbubble.typing{color:var(--muted);font-style:italic}
  .cbubble.typing span{display:inline-block;animation:blink 1.2s infinite}
  @keyframes blink{0%,100%{opacity:.3}50%{opacity:1}}

  /* ---- tabs + controls ---- */
  .bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}
  .tabs{display:inline-flex;background:#fff;border:1px solid var(--line);border-radius:11px;padding:4px;gap:4px}
  .tab{padding:8px 16px;border-radius:8px;cursor:pointer;font-weight:600;color:var(--muted);transition:.15s}
  .tab.active{background:var(--brand);color:#fff;box-shadow:0 4px 10px -4px rgba(37,99,235,.5)}
  .bar-spacer{flex:1}
  .controls{display:flex;gap:10px;flex-wrap:wrap}
  .controls input,.controls select{padding:10px 13px;border:1px solid var(--line);border-radius:10px;
    font-size:14px;background:#fff;outline:none;transition:.15s}
  .controls input:focus,.controls select:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(37,99,235,.1)}
  .controls input{min-width:240px}

  /* ---- table ---- */
  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:var(--shadow)}
  table{width:100%;border-collapse:collapse}
  th,td{text-align:left;padding:13px 16px;vertical-align:middle}
  thead th{background:#f3f7fd;font-size:11px;text-transform:uppercase;letter-spacing:.6px;font-weight:700;
    color:var(--muted);cursor:pointer;user-select:none;border-bottom:1px solid var(--line);white-space:nowrap}
  thead th:hover{color:var(--ink)}
  tbody td{border-bottom:1px solid var(--line)}
  tbody tr:nth-child(even){background:#fafcff}
  tbody tr:last-child td{border-bottom:none}
  tbody tr{transition:.12s}
  tbody tr:hover{background:#eef4ff}
  td.prog{font-weight:700;max-width:380px;color:var(--ink);vertical-align:top}
  td.prog .area{display:inline-block;margin:6px 8px 0 0;font-size:11px;font-weight:600;color:var(--brand-d);
    background:var(--brand-soft);padding:2px 9px;border-radius:999px}
  td.prog .apply{display:block;margin-top:6px}
  td.prog .apply a{color:var(--brand);text-decoration:none;font-weight:600;font-size:12px}
  td.prog .apply a:hover{text-decoration:underline}
  .av{display:inline-flex;align-items:center;gap:9px;font-weight:600}
  .av .dot{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-size:11px;
    font-weight:800;color:#fff;flex:none;letter-spacing:.3px}
  .badge{display:inline-flex;align-items:center;gap:5px;padding:4px 11px;border-radius:999px;font-size:11px;font-weight:700;text-transform:capitalize}
  .badge::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.85}
  .b-open{background:var(--open-bg);color:var(--open)}
  .b-closed{background:var(--closed-bg);color:var(--closed)}
  .b-unknown{background:var(--unk-bg);color:var(--unk)}
  .amt{font-variant-numeric:tabular-nums;white-space:nowrap}
  .amt.has{color:var(--green-d);font-weight:800}
  .muted{color:var(--muted)}
  .empty{padding:54px;text-align:center;color:var(--muted)}
  footer{max-width:1180px;margin:0 auto;padding:18px 22px 40px;color:var(--muted);font-size:12px}
  @media(max-width:820px){.hstats{grid-template-columns:repeat(2,1fr)}.brand small{display:none}}

  /* ---- auth modal (login / signup) ---- */
  .auth-overlay{position:fixed;inset:0;z-index:60;display:none;align-items:center;justify-content:center;
    background:rgba(15,37,64,.45);backdrop-filter:blur(3px);padding:20px;overflow-y:auto;-webkit-overflow-scrolling:touch}
  .auth-overlay.show{display:flex}
  .auth-modal{position:relative;width:100%;max-width:400px;margin:auto;background:var(--card);border:1px solid var(--line);
    border-radius:16px;box-shadow:var(--shadow);border-top:3px solid var(--brand);padding:26px;
    max-height:calc(100vh - 40px);max-height:calc(100dvh - 40px);overflow-y:auto}
  @media(max-width:480px){
    .auth-overlay{padding:12px}
    .auth-modal{padding:20px;border-radius:14px;max-height:calc(100vh - 24px);max-height:calc(100dvh - 24px)}
  }
  .auth-x{position:absolute;top:11px;right:14px;border:none;background:none;font-size:23px;line-height:1;
    color:var(--muted);cursor:pointer}
  .auth-brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:16px;margin-bottom:16px}
  .auth-tabs{display:flex;background:#f3f7fd;border:1px solid var(--line);border-radius:11px;padding:4px;gap:4px;margin-bottom:18px}
  .auth-tab{flex:1;text-align:center;padding:8px;border-radius:8px;cursor:pointer;font-weight:700;color:var(--muted);font-size:13.5px;transition:.15s}
  .auth-tab.active{background:var(--brand);color:#fff;box-shadow:0 4px 10px -4px rgba(37,99,235,.5)}
  .auth-field{margin-bottom:13px}
  .auth-field label{display:block;font-size:12.5px;font-weight:600;margin-bottom:5px}
  .auth-field .opt{color:var(--muted);font-weight:500}
  .auth-field input{width:100%;padding:11px 13px;border:1px solid var(--line);border-radius:10px;font-size:14px;outline:none;transition:.15s}
  .auth-field input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(37,99,235,.12)}
  .auth-field .hint{font-size:11.5px;color:var(--muted);margin-top:5px}
  .auth-msg{border-radius:10px;padding:9px 12px;font-size:12.5px;margin-bottom:13px}
  .auth-msg.err{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c}
  .auth-msg.ok{background:var(--green-soft);border:1px solid #c7eedd;color:var(--green-d)}
  .auth-submit{width:100%;padding:12px;border:none;border-radius:10px;background:var(--brand);color:#fff;
    font-weight:700;font-size:14px;cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:8px}
  .auth-submit:hover{background:var(--brand-d)}
  .auth-submit:disabled{opacity:.7;cursor:not-allowed}
  .auth-spin{width:15px;height:15px;border:2px solid rgba(255,255,255,.5);border-top-color:#fff;border-radius:50%;animation:auth-spin .6s linear infinite}
  @keyframes auth-spin{to{transform:rotate(360deg)}}
  .auth-switch{text-align:center;font-size:12.5px;color:var(--muted);margin-top:14px}
  .auth-switch a{color:var(--brand);font-weight:600;cursor:pointer}

  /* ---- Google Sign-In (hidden until /auth/config says it's configured) ---- */
  .auth-or{display:none;align-items:center;gap:10px;margin:16px 0 14px;color:var(--muted);font-size:11.5px;
    font-weight:600;letter-spacing:.4px;text-transform:uppercase}
  .auth-or::before,.auth-or::after{content:"";flex:1;height:1px;background:var(--line)}
  .auth-google{display:none;justify-content:center;min-height:42px}
  .auth-or.show{display:flex} .auth-google.show{display:flex}

  /* ---- logged-in user menu (navbar) ---- */
  .usermenu{position:relative}
  .uavatar{width:24px;height:24px;border-radius:7px;background:linear-gradient(135deg,var(--brand),var(--green));
    color:#fff;font-size:10.5px;font-weight:800;display:grid;place-items:center;letter-spacing:.3px}
  .uname{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .udrop{display:none;position:absolute;right:0;top:calc(100% + 8px);min-width:190px;background:var(--card);
    border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:6px;z-index:40}
  .udrop-email{font-size:12px;color:var(--muted);padding:8px 10px 6px;border-bottom:1px solid var(--line);
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:4px}
  .udrop-item{width:100%;text-align:left;background:none;border:none;padding:9px 10px;border-radius:8px;
    font-size:13px;font-weight:600;color:var(--ink);cursor:pointer}
  .udrop-item:hover{background:#f3f7fd;color:var(--brand-d)}
  @media(max-width:480px){ .uname{display:none} }

  /* ---- auth gate: dashboard is blurred until the user signs in ---- */
  body.auth-locked .wrap, body.auth-locked footer{filter:blur(7px);pointer-events:none;user-select:none}

  /* ---- bookmark stars ---- */
  .star{border:none;background:none;cursor:pointer;font-size:17px;line-height:1;
    color:#c9d6e6;transition:.15s;padding:2px 4px}
  .star:hover{transform:scale(1.2);color:#f59e0b}
  .star.on{color:#f59e0b}

  /* ---- remember me ---- */
  .auth-remember{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted);
    margin-bottom:13px;font-weight:600;cursor:pointer;user-select:none}
  .auth-remember input{accent-color:var(--brand);width:15px;height:15px;cursor:pointer}

  /* ---- opportunity detail modal ---- */
  .orow{cursor:pointer}
  .badge.b-rolling{background:#e0edff;color:#1d4ed8}
  .opp-modal{position:relative;width:100%;max-width:560px;margin:auto;background:var(--card);
    border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);border-top:3px solid var(--brand);
    padding:24px 26px;max-height:calc(100vh - 40px);max-height:calc(100dvh - 40px);overflow-y:auto}
  .opp-h{font-size:18px;font-weight:800;line-height:1.32;margin:0 20px 0 0;color:var(--ink)}
  .opp-ag{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:13px;margin:9px 0 14px}
  .opp-desc{font-size:13.5px;line-height:1.6;color:var(--ink);background:var(--brand-soft);
    border:1px solid #dbe6ff;border-radius:10px;padding:12px 14px;margin-bottom:16px}
  .opp-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-bottom:18px}
  .opp-field .k{color:var(--muted);font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;margin-bottom:3px}
  .opp-field .v{color:var(--ink);font-weight:600;font-size:13.5px;line-height:1.45}
  .opp-field.full{grid-column:1 / -1}
  .opp-actions{display:flex;gap:10px;flex-wrap:wrap}
  .opp-btn{padding:10px 16px;border-radius:10px;font-weight:700;font-size:13px;text-decoration:none;cursor:pointer;border:none;display:inline-block}
  .opp-btn.primary{background:var(--brand);color:#fff}
  .opp-btn.primary:hover{background:var(--brand-d)}
  .opp-btn.ghost{background:#fff;border:1px solid var(--line);color:var(--ink)}
  .opp-btn.ghost:hover{border-color:#cdd9e8}
  @media(max-width:520px){.opp-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<nav class="nav">
  <div class="nav-in">
    <div class="brand">
      <span class="logo">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </span>
      <span>FundRadar<small>Funding Opportunity Intelligence</small></span>
    </div>
    <div class="nav-spacer"></div>
    <div id="authNav"></div>
  </div>
</nav>

<div class="wrap">
  <div class="hero">
    <h1>Funding Opportunities</h1>
    <p>AI-extracted grants, fellowships &amp; research calls — pulled automatically from agency websites and PDFs.</p>
    <div class="hstats" id="stats"></div>
  </div>

  <div class="ask">
    <div class="ask-h">💬 Ask FundRadar</div>
    <div class="ask-sub">Ask in plain English — answers come straight from the live funding database.</div>
    <div id="chatthread" class="chatthread">
      <div class="cbubble a">Hi! I answer from the live funding database — amounts, deadlines and links included. Try a question below, or type your own.</div>
    </div>
    <div class="chips">
      <span class="chip" onclick="ask('What grants are open now?')">What grants are open now?</span>
      <span class="chip" onclick="ask('Fellowships for PhD students')">Fellowships for PhD students</span>
      <span class="chip" onclick="ask('Funding above 10 lakh')">Funding above 10 lakh</span>
      <span class="chip" onclick="ask('Opportunities in Germany')">Opportunities in Germany</span>
      <span class="chip" onclick="ask('Biotech startup funding')">Biotech startup funding</span>
    </div>
    <div class="ask-row">
      <input id="chatq" placeholder="Type a question, or tap an example above…" onkeydown="if(event.key==='Enter')askBot()"/>
      <button onclick="askBot()">Ask</button>
    </div>
  </div>

  <div class="bar">
    <div class="tabs">
      <div class="tab active" data-view="opps" onclick="switchView('opps')">Opportunities</div>
      <div class="tab" data-view="agencies" onclick="switchView('agencies')">Agencies</div>
    </div>
    <div class="bar-spacer"></div>
    <div class="controls">
      <input id="search" placeholder="Search schemes, agencies, topics…" oninput="render()"/>
      <select id="statusFilter" onchange="render()">
        <option value="">All statuses</option>
        <option value="open">Open</option>
        <option value="closed">Closed</option>
        <option value="unknown">Unknown</option>
      </select>
      <select id="countryFilter" onchange="render()"><option value="">All countries</option></select>
    </div>
  </div>

  <div class="panel"><div id="table"></div></div>
</div>
<footer id="foot"></footer>

<!-- ===== Auth modal (login / signup) — reusable component ===== -->
<div id="authOverlay" class="auth-overlay" onclick="if(event.target===this)closeAuth()">
  <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="authTitle">
    <button class="auth-x" onclick="closeAuth()" aria-label="Close">&times;</button>
    <div class="auth-brand" id="authTitle">
      <span class="logo"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></span>
      FundRadar
    </div>
    <div class="auth-tabs">
      <div id="tab-login"  class="auth-tab active" onclick="switchAuthTab('login')">Log in</div>
      <div id="tab-signup" class="auth-tab"        onclick="switchAuthTab('signup')">Sign up</div>
    </div>
    <form id="authForm" onsubmit="return submitAuth(event)" novalidate>
      <div class="auth-field" id="row-name" style="display:none">
        <label>Full name <span class="opt">(optional)</span></label>
        <input id="au-name" type="text" autocomplete="name" placeholder="Ada Lovelace"/>
      </div>
      <div class="auth-field">
        <label>Email</label>
        <input id="au-email" type="email" autocomplete="email" required placeholder="you@example.com"/>
      </div>
      <div class="auth-field">
        <label>Password</label>
        <input id="au-pass" type="password" required placeholder="••••••••"/>
        <div class="hint" id="au-passhint" style="display:none">At least 8 characters.</div>
      </div>
      <label class="auth-remember" id="row-remember">
        <input type="checkbox" id="au-remember"/> Keep me signed in for 30 days
      </label>
      <div id="au-msg" class="auth-msg" style="display:none"></div>
      <button id="au-submit" class="auth-submit" type="submit">Log in</button>
    </form>
    <!-- Google Sign-In. Both elements stay hidden unless /auth/config reports a
         configured Client ID, so nothing appears half-working if it isn't set. -->
    <div class="auth-or" id="au-or">or</div>
    <div class="auth-google" id="au-google"></div>
    <div class="auth-switch" id="au-switch"></div>
  </div>
</div>

<!-- ===== Opportunity detail modal ===== -->
<div id="oppModal" class="auth-overlay" onclick="if(event.target===this)closeOpp()">
  <div class="opp-modal" role="dialog" aria-modal="true" aria-labelledby="oppTitle">
    <button class="auth-x" onclick="closeOpp()" aria-label="Close">&times;</button>
    <div id="oppBody"></div>
  </div>
</div>

<script>
let OPP=[], AG=[], AGMAP={}, view='opps', sortKey='best', sortDir=1;
let SAVED=new Set();   // ids of the signed-in user's bookmarked opportunities
const AV_COLORS=['#2563eb','#059669','#7c3aed','#db2777','#ea580c','#0891b2','#4f46e5','#0d9488'];
function avColor(s){let h=0;for(const ch of (s||'?')) h=(h*31+ch.charCodeAt(0))>>>0; return AV_COLORS[h%AV_COLORS.length];}
function initials(n){return (n||'?').replace(/[^A-Za-z0-9 ]/g,'').split(/\s+/).filter(Boolean).map(w=>w[0]).slice(0,2).join('').toUpperCase()||'?';}

/* Authentication logic is isolated in its own module near the end of this file
   (see "FundRadar — Authentication module"), kept separate from dashboard code. */

async function toggleSave(id,btn){
  const saved=SAVED.has(id);
  try{
    const r=await fetch('/auth/saved/'+id,{method:saved?'DELETE':'POST',credentials:'include'});
    if(!r.ok) return;
    saved?SAVED.delete(id):SAVED.add(id);
    btn.classList.toggle('on',!saved);
    btn.title=saved?'Save for later':'Remove bookmark';
  }catch(_){}
}

async function loadSaved(){
  try{
    const r=await fetch('/auth/saved/ids',{credentials:'include'});
    if(r.ok){ SAVED=new Set((await r.json()).ids); }
  }catch(_){}
}

async function load(){
  await loadSaved();
  const [o,a] = await Promise.all([
    fetch('/opportunities?limit=300').then(r=>r.json()),
    fetch('/agencies?limit=300').then(r=>r.json())
  ]);
  OPP=o.items||[]; AG=a.items||[];
  AG.forEach(x=>AGMAP[x.id]={name:x.name,country:x.country,code:x.agency_code});
  const cf=document.getElementById('countryFilter');
  [...new Set(AG.map(x=>x.country).filter(Boolean))].sort().forEach(c=>{
    const op=document.createElement('option');op.value=c;op.textContent=c;cf.appendChild(op);
  });
  stats(); render();
}

const ICONS={
  list:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>',
  check:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>',
  bank:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/></svg>',
  globe:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/></svg>'
};
function stats(){
  const open=OPP.filter(o=>o.status==='open').length;
  const countries=new Set(AG.map(a=>a.country).filter(Boolean)).size;
  const cards=[
    ['list', OPP.length, 'Opportunities tracked'],
    ['check',open,       'Open right now'],
    ['bank', AG.length,  'Funding agencies'],
    ['globe',countries,  'Countries & blocs'],
  ];
  document.getElementById('stats').innerHTML=cards.map(([ic,n,l])=>
    `<div class="hstat"><div class="ic">${ICONS[ic]}</div><div class="n">${n}</div><div class="l">${l}</div></div>`
  ).join('');
}

function switchView(v){
  view=v;
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.view===v));
  document.getElementById('statusFilter').style.display = v==='opps'?'':'none';
  sortKey = v==='opps'?'best':'name'; sortDir=1;
  render();
}

function fmtDate(d){
  if(!d) return '<span class="muted">—</span>';
  const dt=new Date(d); if(isNaN(dt)) return d;
  return dt.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
}
function amount(o){
  if(o.amount_value){return (o.currency||'')+' '+Number(o.amount_value).toLocaleString();}
  if(o.funding_amount){var s=String(o.funding_amount);return s.length>46?s.slice(0,44)+'…':s;}
  return '<span class="muted">—</span>';
}
function agencyCell(name){
  if(!name) return '<span class="muted">—</span>';
  return `<span class="av"><span class="dot" style="background:${avColor(name)}">${initials(name)}</span>${name}</span>`;
}
function badge(s){s=s||'unknown';const isU=s==='unknown';const cls=isU?'rolling':s;const label=isU?'rolling':s;return `<span class="badge b-${cls}">${label}</span>`;}
function sortBy(k){ if(sortKey===k){sortDir*=-1;}else{sortKey=k;sortDir=1;} render(); }

/* ---- opportunity detail modal ---- */
function escH(s){return (s==null?'':String(s)).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function fieldV(v){v=(v==null?'':String(v)).trim();return v?escH(v):null;}
function openOpp(id){
  const o=OPP.find(x=>x.id===id); if(!o) return;
  const ag=AGMAP[o.agency_id]||{};
  const amount=o.amount_value?escH((o.currency?o.currency+' ':'')+Number(o.amount_value).toLocaleString())
    :(fieldV(o.funding_amount)||'Not specified');
  const deadline=o.deadline?fmtDate(o.deadline):'Rolling — no fixed deadline';
  const st=(o.status==='unknown'||!o.status)?'rolling':o.status;
  let desc=fieldV(o.summary);
  if(!desc){
    let d='A funding opportunity'+(ag.name?(' offered by '+escH(ag.name)):'');
    if(ag.country) d+=' based in '+escH(ag.country);
    if(fieldV(o.research_area)) d+=', focused on '+fieldV(o.research_area);
    desc=d+'. A specific amount and deadline aren’t published on the source page — use the link below for the latest details.';
  }
  const F=[['Amount',amount],['Deadline',escH(deadline)],['Status',st]];
  if(fieldV(o.research_area)) F.push(['Research area',fieldV(o.research_area)]);
  if(fieldV(o.eligibility)) F.push(['Eligibility',fieldV(o.eligibility),true]);
  if(fieldV(o.tags)) F.push(['Tags',fieldV(o.tags).replace(/,\s*/g,', '),true]);
  const grid=F.map(f=>`<div class="opp-field ${f[2]?'full':''}"><div class="k">${f[0]}</div><div class="v">${f[1]}</div></div>`).join('');
  const saved=SAVED.has(o.id);
  document.getElementById('oppBody').innerHTML=`
    <div class="opp-h" id="oppTitle">${fieldV(o.program_name)||'Untitled scheme'}</div>
    <div class="opp-ag"><span class="dot" style="width:26px;height:26px;border-radius:8px;display:inline-grid;place-items:center;color:#fff;font-size:10px;font-weight:800;background:${avColor(ag.name||'?')}">${initials(ag.name||'?')}</span>${escH(ag.name||'Unknown agency')}${ag.country?' · '+escH(ag.country):''}</div>
    <div class="opp-desc">${desc}</div>
    <div class="opp-grid">${grid}</div>
    <div class="opp-actions">
      ${o.application_link?`<a class="opp-btn primary" href="${escH(o.application_link)}" target="_blank" rel="noopener">Apply / details ↗</a>`:''}
      ${o.source_url?`<a class="opp-btn ghost" href="${escH(o.source_url)}" target="_blank" rel="noopener">Source page ↗</a>`:''}
      <button id="oppSave" class="opp-btn ghost" onclick="modalSave(${o.id})">${saved?'★ Saved':'☆ Save for later'}</button>
    </div>`;
  document.getElementById('oppModal').classList.add('show');
}
async function modalSave(id){
  const btn=document.getElementById('oppSave');
  await toggleSave(id,btn);
  btn.textContent=SAVED.has(id)?'★ Saved':'☆ Save for later';
}
function closeOpp(){ document.getElementById('oppModal').classList.remove('show'); }
document.addEventListener('keydown',e=>{ if(e.key==='Escape') closeOpp(); });

function render(){
  const q=document.getElementById('search').value.toLowerCase();
  const sf=document.getElementById('statusFilter').value;
  const cf=document.getElementById('countryFilter').value;
  const el=document.getElementById('table');
  if(view==='opps'){
    let rows=OPP.map(o=>({...o, agency:(AGMAP[o.agency_id]||{}).name||'', country:(AGMAP[o.agency_id]||{}).country||''}));
    rows=rows.filter(o=>(!sf||o.status===sf)&&(!cf||o.country===cf)&&
      (!q||[o.program_name,o.agency,o.research_area,o.tags].join(' ').toLowerCase().includes(q)));
    if(sortKey==='best'){
      // default: fullest records first (have amount + deadline), then open, then soonest
      const comp=o=>((o.amount_value||o.funding_amount)?1:0)+(o.deadline?1:0);
      rows.sort((a,b)=>{
        const d=comp(b)-comp(a); if(d) return d;
        const oa=a.status==='open'?0:1, ob=b.status==='open'?0:1; if(oa!==ob) return oa-ob;
        return String(a.deadline||'9999').localeCompare(String(b.deadline||'9999'));
      });
    }else{
      rows.sort((a,b)=>{let x=a[sortKey]||'',y=b[sortKey]||'';return (x>y?1:x<y?-1:0)*sortDir;});
    }
    if(!rows.length){el.innerHTML='<div class="empty">No matching opportunities.</div>';foot(0);return;}
    el.innerHTML=`<table><thead><tr>
      <th style="width:34px" title="Saved"></th>
      <th onclick="sortBy('program_name')">Programme</th>
      <th onclick="sortBy('agency')">Agency</th>
      <th onclick="sortBy('country')">Country</th>
      <th onclick="sortBy('amount_value')">Amount</th>
      <th onclick="sortBy('deadline')">Deadline</th>
      <th onclick="sortBy('status')">Status</th>
    </tr></thead><tbody>${rows.map(o=>`<tr class="orow" onclick="openOpp(${o.id})" title="Click for full details">
      <td><button class="star ${SAVED.has(o.id)?'on':''}" title="${SAVED.has(o.id)?'Remove bookmark':'Save for later'}" onclick="event.stopPropagation();toggleSave(${o.id},this)">★</button></td>
      <td class="prog">${o.program_name||'<span class=muted>Untitled scheme</span>'}${o.research_area?`<div class="area">${o.research_area}</div>`:''}
        ${(o.application_link||o.source_url)?`<div class="apply"><a href="${escH(o.application_link||o.source_url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">${o.application_link?'Apply / details':'View source page'} ↗</a></div>`:''}</td>
      <td>${agencyCell(o.agency)}</td>
      <td>${o.country||'<span class=muted>—</span>'}</td>
      <td class="amt ${o.amount_value?'has':''}">${amount(o)}</td>
      <td>${fmtDate(o.deadline)}</td>
      <td>${badge(o.status)}</td>
    </tr>`).join('')}</tbody></table>`;
    foot(rows.length);
  } else {
    let rows=AG.filter(a=>(!cf||a.country===cf)&&
      (!q||[a.name,a.agency_code,a.category,a.country].join(' ').toLowerCase().includes(q)));
    rows.sort((a,b)=>{let x=a[sortKey]||'',y=b[sortKey]||'';return (x>y?1:x<y?-1:0)*sortDir;});
    if(!rows.length){el.innerHTML='<div class="empty">No matching agencies.</div>';foot(0);return;}
    el.innerHTML=`<table><thead><tr>
      <th onclick="sortBy('agency_code')">Code</th>
      <th onclick="sortBy('name')">Agency</th>
      <th onclick="sortBy('country')">Country</th>
      <th onclick="sortBy('category')">Category</th>
      <th>Website</th>
    </tr></thead><tbody>${rows.map(a=>`<tr>
      <td class="muted">${a.agency_code}</td>
      <td>${agencyCell(a.name)}</td>
      <td>${a.country||'—'}</td>
      <td>${a.category||'<span class=muted>—</span>'}</td>
      <td>${a.website?`<a href="${a.website}" target="_blank" rel="noopener" style="color:var(--brand);font-weight:600;text-decoration:none">Visit ↗</a>`:'—'}</td>
    </tr>`).join('')}</tbody></table>`;
    foot(rows.length);
  }
}
function foot(n){document.getElementById('foot').textContent=`Showing ${n} ${view==='opps'?'opportunities':'agencies'} · data served live from the FundRadar API`;}

function ask(text){ document.getElementById('chatq').value=text; askBot(); }
function escText(s){return (s==null?'':String(s)).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function chatBubble(cls,html){
  const t=document.getElementById('chatthread');
  const d=document.createElement('div');
  d.className='cbubble '+cls;
  d.innerHTML=html;
  t.appendChild(d);
  t.scrollTop=t.scrollHeight;
  return d;
}
function renderAnswer(text){
  // Escape HTML first (safety), then apply light markdown and turn "- " lines
  // into a real bulleted list.
  const esc=s=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const inline=s=>{
    let h=esc(s);
    h=h.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>');
    // markdown links [text](url) first, then any bare URLs
    h=h.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>');
    h=h.replace(/(^|[^">])(https?:\/\/[^\s<)]+)/g,'$1<a href="$2" target="_blank" rel="noopener">$2</a>');
    return h;
  };
  const out=[]; let li=[];
  const flush=()=>{ if(li.length){ out.push('<ul class="chatlist">'+li.join('')+'</ul>'); li=[]; } };
  for(const raw of text.split('\n')){
    const line=raw.replace(/\s+$/,'');
    const m=line.match(/^\s*[-*•]\s+(.*)$/);
    if(m){ li.push('<li>'+inline(m[1])+'</li>'); }
    else{ flush(); if(line.trim()) out.push('<p>'+inline(line)+'</p>'); }
  }
  flush();
  return out.join('');
}
async function askBot(){
  const inp=document.getElementById('chatq');
  const q=inp.value.trim(); if(!q) return;
  inp.value='';
  chatBubble('q', escText(q));                                  // user message
  const bot=chatBubble('a typing','<span>Thinking…</span>');    // placeholder
  try{
    const r=await fetch('/chat?q='+encodeURIComponent(q));
    const d=await r.json();
    bot.className='cbubble a';
    bot.innerHTML=renderAnswer(d.answer||'(no answer)');
  }catch(e){
    bot.className='cbubble a';
    bot.textContent='Could not reach the chatbot. Is the server running?';
  }
  document.getElementById('chatthread').scrollTop=9e9;
}

/* Data loads only after the auth module confirms a signed-in session. */
let dashStarted=false;
window.startDashboard=function(){
  if(dashStarted) return; dashStarted=true;
  load().catch(e=>{document.getElementById('table').innerHTML=
    '<div class="empty">Could not load data. Make sure the server is running.</div>';});
};
</script>

<!-- ==================== FundRadar — Authentication module ====================
     Self-contained: ALL login/signup logic lives in the IIFE below, isolated
     from the dashboard script above so the two can be maintained separately.
     Talks to /auth/login and /auth/signup; exposes only the handlers that the
     modal markup references (openAuth, closeAuth, switchAuthTab, submitAuth).
     ========================================================================= -->
<script>
(function () {
  "use strict";
  let authMode = 'login';
  const $ = (id) => document.getElementById(id);

  function openAuth(mode){ authMode = mode || 'login'; syncAuth(); clearAuthMsg();
    $('authOverlay').classList.add('show'); setTimeout(()=>$('au-email').focus(),40);
    // The Google button must be drawn while the modal is visible, otherwise it
    // measures a width of 0 and renders as a sliver.
    renderGoogleButton(); }
  function closeAuth(){
    // Dashboard requires login: closing the modal while locked returns to the
    // public landing page instead of revealing the blurred dashboard.
    if(document.body.classList.contains('auth-locked')){ location.href='/'; return; }
    $('authOverlay').classList.remove('show'); }
  function lockDashboard(){ document.body.classList.add('auth-locked'); openAuth('login'); }
  function unlockDashboard(){ document.body.classList.remove('auth-locked');
    if(window.startDashboard) window.startDashboard(); }
  function switchAuthTab(mode){ authMode = mode; clearAuthMsg(); syncAuth(); }

  function syncAuth(){
    const login = authMode === 'login';
    $('tab-login').classList.toggle('active', login);
    $('tab-signup').classList.toggle('active', !login);
    $('row-name').style.display = login ? 'none' : '';
    $('row-remember').style.display = login ? '' : 'none';
    $('au-passhint').style.display = login ? 'none' : '';
    $('au-submit').textContent = login ? 'Log in' : 'Create account';
    $('au-switch').innerHTML = login
      ? "New here? <a onclick=\"switchAuthTab('signup')\">Create an account</a>"
      : "Already have an account? <a onclick=\"switchAuthTab('login')\">Log in</a>";
  }

  function clearAuthMsg(){ const m=$('au-msg'); m.style.display='none'; m.textContent=''; }
  function showAuthMsg(text, kind){ const m=$('au-msg'); m.className='auth-msg '+kind; m.textContent=text; m.style.display='block'; }
  function showAuthMsgHTML(html, kind){ const m=$('au-msg'); m.className='auth-msg '+kind; m.innerHTML=html; m.style.display='block'; }
  async function resendVerification(email){
    try{
      await fetch('/auth/resend-verification',{method:'POST',headers:{'Content-Type':'application/json'},
        credentials:'include',body:JSON.stringify({email})});
      showAuthMsg('Verification email sent to '+email+'. Check your inbox.','ok');
    }catch(_){ showAuthMsg('Could not resend right now — please try again.','err'); }
  }
  function setAuthLoading(on){ const b=$('au-submit'); b.disabled=on;
    b.innerHTML = on ? '<span class="auth-spin"></span> Please wait…' : (authMode==='login' ? 'Log in' : 'Create account'); }

  async function readDetail(r, fallback){
    try{ const d = await r.json();
      if(typeof d.detail === 'string') return d.detail;
      if(Array.isArray(d.detail) && d.detail[0] && d.detail[0].msg) return d.detail[0].msg;
    }catch(_){}
    return fallback;
  }

  async function submitAuth(e){
    e.preventDefault(); clearAuthMsg();
    const email = $('au-email').value.trim();
    const password = $('au-pass').value;
    const full_name = $('au-name').value.trim();
    if(!email || !password){ showAuthMsg('Please enter your email and password.','err'); return false; }
    if(authMode==='signup' && password.length < 8){ showAuthMsg('Password must be at least 8 characters.','err'); return false; }
    setAuthLoading(true);
    try{
      if(authMode==='signup'){
        const r = await fetch('/auth/signup', {method:'POST', headers:{'Content-Type':'application/json'},
          credentials:'include', body:JSON.stringify({email, password, full_name: full_name||null})});
        if(r.status===201){
          const u = await r.json().catch(()=>({}));
          if(u && u.is_verified===false){
            // Email verification is on: don't log in yet — ask them to confirm.
            authMode='login'; syncAuth(); $('au-pass').value='';
            showAuthMsg("Account created! We've emailed a verification link to "+email
              +". Click it, then log in.",'ok');
          }else{
            // No email provider configured — log the new account straight in.
            const l = await fetch('/auth/login', {method:'POST', headers:{'Content-Type':'application/json'},
              credentials:'include', body:JSON.stringify({email, password})});
            if(l.ok){ const lu = await l.json(); showAuthMsg('Welcome, '+(lu.full_name||lu.email)+'!','ok');
              await refreshSession(); setTimeout(closeAuth,800); }
            else{ authMode='login'; syncAuth(); $('au-pass').value='';
              showAuthMsg('Account created — please log in.','ok'); }
          }
        }
        else{ showAuthMsg(await readDetail(r,'Could not create account.'),'err'); }
      }else{
        const remember = $('au-remember').checked;
        const r = await fetch('/auth/login', {method:'POST', headers:{'Content-Type':'application/json'},
          credentials:'include', body:JSON.stringify({email, password, remember_me: remember})});
        if(r.ok){ const u = await r.json(); showAuthMsg('Signed in as '+u.email+'.','ok'); await refreshSession(); setTimeout(closeAuth,800); }
        else{
          const detail = await readDetail(r,'Invalid email or password.');
          if(r.status===403 && /verify/i.test(detail)){
            showAuthMsgHTML(esc(detail)+' <a id="resendLink" style="color:var(--brand);font-weight:600;cursor:pointer">Resend email</a>','err');
            const rl=$('resendLink'); if(rl) rl.onclick=()=>resendVerification(email);
          }else{ showAuthMsg(detail,'err'); }
        }
      }
    }catch(_){ showAuthMsg('Network error — please try again.','err'); }
    finally{ setAuthLoading(false); }
    return false;
  }

  document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') closeAuth(); });

  /* ---- session / navbar reflection (via /auth/me and /auth/logout) ---- */
  function esc(s){ return (s==null?'':String(s)).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function initialsOf(s){ return (s||'?').replace(/[^A-Za-z0-9 ]/g,'').split(/\s+/).filter(Boolean).map(w=>w[0]).slice(0,2).join('').toUpperCase() || '?'; }
  let menuOpen = false;

  function renderLoggedOut(){
    $('authNav').innerHTML =
      "<button class=\"gbtn\" onclick=\"openAuth('login')\">"
      + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>'
      + ' Sign in</button>';
  }
  function renderLoggedIn(u){
    const name = u.full_name || u.email;
    $('authNav').innerHTML =
      '<div class="usermenu">'
      + '<button class="gbtn" onclick="toggleUserMenu()">'
      +   '<span class="uavatar">' + esc(initialsOf(name)) + '</span>'
      +   '<span class="uname">' + esc(name) + '</span>'
      +   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>'
      + '</button>'
      + '<div class="udrop" id="udrop">'
      +   '<div class="udrop-email">' + esc(u.email) + '</div>'
      +   '<button class="udrop-item" onclick="location.href=\'/profile\'">My profile</button>'
      +   '<button class="udrop-item" onclick="logout()">Log out</button>'
      + '</div></div>';
    menuOpen = false;
  }
  async function refreshSession(){
    try{
      const r = await fetch('/auth/me', {credentials:'include'});
      if(r.ok){ renderLoggedIn(await r.json()); unlockDashboard(); return; }
    }catch(_){}
    renderLoggedOut();
    lockDashboard();
  }
  function toggleUserMenu(){ const d=$('udrop'); if(!d) return; menuOpen = !menuOpen; d.style.display = menuOpen ? 'block' : 'none'; }
  async function logout(){
    try{ await fetch('/auth/logout', {method:'POST', credentials:'include'}); }catch(_){}
    await refreshSession();   // renders logged-out
  }
  document.addEventListener('click', (e)=>{ if(menuOpen && !e.target.closest('.usermenu')){ menuOpen=false; const d=$('udrop'); if(d) d.style.display='none'; } });

  /* ---- Google Sign-In ------------------------------------------------------
     Progressive enhancement. We ask the server whether a Client ID is
     configured; if it isn't, none of this runs and the modal looks and behaves
     exactly as it did before. Any failure here (Google blocked, offline,
     script blocked by an extension) is swallowed on purpose — email/password
     login must never break because a third-party script didn't load. */
  let gsiReady = false;

  function loadScript(src){
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src; s.async = true; s.defer = true;
      s.onload = resolve; s.onerror = () => reject(new Error('script blocked'));
      document.head.appendChild(s);
    });
  }

  async function handleGoogleCredential(resp){
    clearAuthMsg();
    if(!resp || !resp.credential){ showAuthMsg('Google sign-in was cancelled.','err'); return; }
    showAuthMsg('Signing you in with Google…','ok');
    try{
      const r = await fetch('/auth/google', {method:'POST', headers:{'Content-Type':'application/json'},
        credentials:'include', body: JSON.stringify({credential: resp.credential, remember_me: true})});
      if(r.ok){
        const u = await r.json();
        showAuthMsg('Signed in as ' + u.email + '.', 'ok');
        await refreshSession();
        setTimeout(closeAuth, 700);
      }else{
        showAuthMsg(await readDetail(r, 'Google sign-in failed. Please try again.'), 'err');
      }
    }catch(_){ showAuthMsg('Network error during Google sign-in.','err'); }
  }

  function renderGoogleButton(){
    const box = $('au-google');
    if(!gsiReady || !box) return;
    // Match the button to the modal width (Google caps it at 400px).
    const available = box.clientWidth || (box.parentElement && box.parentElement.clientWidth) || 340;
    const width = Math.max(220, Math.min(380, available));
    box.innerHTML = '';
    try{
      google.accounts.id.renderButton(box, {theme:'outline', size:'large', shape:'pill',
        text:'continue_with', logo_alignment:'left', width: width});
    }catch(_){ /* leave the area empty rather than showing a broken button */ }
  }

  async function initGoogle(){
    try{
      const r = await fetch('/auth/config', {credentials:'include'});
      if(!r.ok) return;
      const cfg = await r.json();
      if(!cfg.google_enabled || !cfg.google_client_id) return;   // not set up — stay hidden
      await loadScript('https://accounts.google.com/gsi/client');
      if(!(window.google && google.accounts && google.accounts.id)) return;
      google.accounts.id.initialize({
        client_id: cfg.google_client_id,
        callback: handleGoogleCredential,
        auto_select: false,
        cancel_on_tap_outside: true,
      });
      gsiReady = true;
      $('au-or').classList.add('show');
      $('au-google').classList.add('show');
      if($('authOverlay').classList.contains('show')) renderGoogleButton();
    }catch(_){ /* Google unavailable — password login still works normally. */ }
  }

  window.addEventListener('resize', () => {
    if(gsiReady && $('authOverlay').classList.contains('show')) renderGoogleButton();
  });

  // Expose ONLY the handlers referenced by the modal / navbar markup; everything else stays private.
  window.openAuth = openAuth;
  window.closeAuth = closeAuth;
  window.switchAuthTab = switchAuthTab;
  window.submitAuth = submitAuth;
  window.toggleUserMenu = toggleUserMenu;
  window.logout = logout;

  renderLoggedOut();   // show Sign in immediately, then reflect real session
  refreshSession();
  initGoogle();        // adds the Google button only if the server has a Client ID
})();
</script>
<!-- FR-BLOCK:chat START -->
<!-- FundRadar floating chat - opens as a docked right-hand rail (split screen);
     the page shrinks to make room instead of being covered.
     Installed by INSTALL_FUNDRADAR_UI.bat - re-run it to upgrade. -->
<style>
  :root{ --fr-rail: 380px; }

  /* ---- split screen: the page gives up room on the right ---- */
  body{transition:padding-right .26s cubic-bezier(.22,1,.36,1)}
  body.fr-split{padding-right:var(--fr-rail)}

  /* ---------- launcher button ---------- */
  #fr-launch{position:fixed;right:20px;bottom:20px;z-index:9998;width:54px;height:54px;padding:0;
    border:none;border-radius:50%;cursor:pointer;display:grid;place-items:center;color:#fff;
    background:linear-gradient(135deg,#2563eb,#059669);
    box-shadow:0 9px 22px -6px rgba(37,99,235,.55);
    transition:right .26s cubic-bezier(.22,1,.36,1),transform .18s ease,box-shadow .18s ease}
  /* while the rail is open the header's X is the way out, so the bubble hides */
  body.fr-split #fr-launch{right:calc(var(--fr-rail) + 20px);opacity:0;pointer-events:none;transform:scale(.8)}
  #fr-launch:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 14px 30px -8px rgba(37,99,235,.68)}
  #fr-launch svg{width:24px;height:24px;transition:opacity .15s,transform .25s}
  #fr-launch .fr-ico-close{position:absolute;opacity:0;transform:rotate(-90deg) scale(.6)}
  #fr-launch.fr-open .fr-ico-chat{opacity:0;transform:rotate(90deg) scale(.6)}
  #fr-launch.fr-open .fr-ico-close{opacity:1;transform:none}
  #fr-dot{position:absolute;top:2px;right:2px;width:13px;height:13px;border-radius:50%;
    background:#22c55e;border:2.5px solid #fff;animation:fr-pulse 2s infinite}
  #fr-launch.fr-seen #fr-dot{display:none}
  @keyframes fr-pulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.55)}70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}

  /* ---------- the docked rail ---------- */
  #fr-panel{position:fixed;top:0;right:0;bottom:0;z-index:9999;width:var(--fr-rail);
    background:#fff;border-left:1px solid #e6edf5;
    display:flex;flex-direction:column;font-size:13px;line-height:1.5;
    color:#0f2540;font-family:-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    box-shadow:-14px 0 40px -22px rgba(15,37,64,.5);
    transform:translateX(100%);transition:transform .26s cubic-bezier(.22,1,.36,1)}
  #fr-panel.fr-on{transform:none}

  /* drag handle to resize the rail */
  #fr-grip{position:absolute;left:-3px;top:0;bottom:0;width:7px;cursor:col-resize;z-index:2}
  #fr-grip:hover,#fr-grip.fr-drag{background:rgba(37,99,235,.28)}

  .fr-head{display:flex;align-items:center;gap:9px;padding:12px 13px;color:#fff;flex:0 0 auto;
    background:linear-gradient(115deg,#1e40af 0%,#2563eb 45%,#0e9f6e 125%)}
  .fr-head-logo{width:30px;height:30px;border-radius:9px;flex:0 0 auto;display:grid;place-items:center;
    background:rgba(255,255,255,.18)}
  .fr-head-txt{min-width:0;flex:1}
  .fr-head-txt b{display:block;font-size:14px;font-weight:700;letter-spacing:-.15px}
  .fr-head-txt span{display:flex;align-items:center;gap:5px;font-size:10.5px;opacity:.85;font-weight:500}
  .fr-live{width:6px;height:6px;border-radius:50%;background:#4ade80}
  .fr-x{background:rgba(255,255,255,.15);border:none;color:#fff;width:27px;height:27px;border-radius:7px;
    cursor:pointer;display:grid;place-items:center;transition:.15s;flex:0 0 auto}
  .fr-x:hover{background:rgba(255,255,255,.3)}

  .fr-thread{flex:1;overflow-y:auto;padding:12px 12px 4px;background:#f6fafd;
    display:flex;flex-direction:column;gap:9px;scroll-behavior:smooth}
  .fr-thread::-webkit-scrollbar{width:6px}
  .fr-thread::-webkit-scrollbar-thumb{background:#cfdcea;border-radius:9px}
  .fr-thread::-webkit-scrollbar-track{background:transparent}

  .fr-b{max-width:92%;padding:9px 12px;border-radius:13px;font-size:12.5px;line-height:1.55;
    word-wrap:break-word;animation:fr-in .2s ease-out}
  @keyframes fr-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
  .fr-b.q{align-self:flex-end;background:#2563eb;color:#fff;border-bottom-right-radius:4px;
    box-shadow:0 3px 9px -3px rgba(37,99,235,.5)}
  .fr-b.a{align-self:flex-start;background:#fff;border:1px solid #e6edf5;border-bottom-left-radius:4px;
    box-shadow:0 1px 2px rgba(15,37,64,.05)}
  .fr-b.a strong{color:#047857}
  .fr-b.a p{margin:0 0 5px}
  .fr-b.a p:last-child{margin-bottom:0}
  .fr-b.a a{color:#2563eb;font-weight:600;text-decoration:none}
  .fr-b.a a:hover{text-decoration:underline}
  .fr-b.a ul.fr-list{list-style:none;margin:5px 0 0;padding:0;display:flex;flex-direction:column;gap:6px}
  .fr-b.a ul.fr-list li{position:relative;padding-left:14px}
  .fr-b.a ul.fr-list li::before{content:"";position:absolute;left:2px;top:7px;width:5px;height:5px;
    border-radius:50%;background:#059669}
  .fr-typing{display:flex;gap:4px;align-items:center;padding:11px 12px!important}
  .fr-typing i{width:5px;height:5px;border-radius:50%;background:#94a9bf;animation:fr-bounce 1.3s infinite}
  .fr-typing i:nth-child(2){animation-delay:.18s}
  .fr-typing i:nth-child(3){animation-delay:.36s}
  @keyframes fr-bounce{0%,60%,100%{opacity:.3;transform:translateY(0)}30%{opacity:1;transform:translateY(-4px)}}

  .fr-chips{flex:0 0 auto;display:flex;gap:6px;padding:8px 12px 3px;overflow-x:auto;background:#f6fafd;
    scrollbar-width:none}
  .fr-chips::-webkit-scrollbar{display:none}
  .fr-chips button{flex:0 0 auto;font-size:11px;padding:5px 10px;border-radius:999px;cursor:pointer;
    background:#eef4ff;color:#1d4ed8;border:1px solid #dbe6ff;font-weight:600;white-space:nowrap;transition:.15s}
  .fr-chips button:hover{background:#e2ebff;transform:translateY(-1px)}

  .fr-foot{flex:0 0 auto;display:flex;gap:7px;align-items:center;padding:10px 11px;
    background:#fff;border-top:1px solid #e6edf5}
  .fr-foot input{flex:1;min-width:0;padding:9px 12px;font-size:12.5px;border:1px solid #e6edf5;
    border-radius:10px;outline:none;background:#f8fbfe;color:#0f2540;transition:.15s;font-family:inherit}
  .fr-foot input:focus{border-color:#2563eb;background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.11)}
  .fr-send{width:35px;height:35px;flex:0 0 auto;border:none;border-radius:10px;cursor:pointer;color:#fff;
    display:grid;place-items:center;background:linear-gradient(135deg,#2563eb,#059669);transition:.15s}
  .fr-send:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .fr-send:disabled{opacity:.45;cursor:not-allowed;transform:none;filter:none}

  .ask{display:none!important}
  #authOverlay.show ~ #fr-launch,
  #authOverlay.show ~ #fr-panel{display:none!important}

  /* ---- narrow screens: no room to split, fall back to a bottom sheet ---- */
  @media (max-width:900px){
    body.fr-split{padding-right:0}
    body.fr-split #fr-launch{right:14px}
    #fr-panel{top:auto;left:0;right:0;width:100%;height:78vh;border-left:none;
      border-top:1px solid #e6edf5;border-radius:16px 16px 0 0;
      transform:translateY(100%)}
    #fr-panel.fr-on{transform:none}
    #fr-grip{display:none}
    #fr-launch{right:14px;bottom:14px;width:50px;height:50px}
  }
  @media print{#fr-launch,#fr-panel{display:none!important} body.fr-split{padding-right:0}}
</style>

<button id="fr-launch" aria-label="Open FundRadar chat" title="Ask FundRadar">
  <span id="fr-dot"></span>
  <svg class="fr-ico-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.6-.7L3 21l1.9-5A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"/>
    <path d="M8.5 10.5h7M8.5 14h4.5"/>
  </svg>
  <svg class="fr-ico-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
       stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
</button>

<div id="fr-panel" role="complementary" aria-label="FundRadar chat">
  <div id="fr-grip" title="Drag to resize"></div>
  <div class="fr-head">
    <div class="fr-head-logo">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1"
           stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/><path d="M11 8v3l2 1.5"/>
      </svg>
    </div>
    <div class="fr-head-txt">
      <b>Ask FundRadar</b>
      <span><i class="fr-live"></i> Live funding database</span>
    </div>
    <button class="fr-x" id="fr-close" aria-label="Close chat" title="Close">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="fr-thread" id="fr-thread"></div>
  <div class="fr-chips" id="fr-chips"></div>

  <div class="fr-foot">
    <input id="fr-q" type="text" autocomplete="off" placeholder="Ask about grants, deadlines, amounts…"/>
    <button class="fr-send" id="fr-send" aria-label="Send" title="Send">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M21.5 12L3 4.5l3 7.5-3 7.5z"/><path d="M6 12h15.5"/></svg>
    </button>
  </div>
</div>

<script>
(function(){
  var GREET = "Hi! I answer from the live funding database — amounts, deadlines and links included. " +
              "Ask me anything, or tap a suggestion below.";
  var CHIPS = ["What grants are open now?","Fellowships for PhD students","Funding above 10 lakh",
               "Opportunities in Germany","Biotech startup funding"];

  var launch = document.getElementById('fr-launch'),
      panel  = document.getElementById('fr-panel'),
      grip   = document.getElementById('fr-grip'),
      thread = document.getElementById('fr-thread'),
      chips  = document.getElementById('fr-chips'),
      input  = document.getElementById('fr-q'),
      sendB  = document.getElementById('fr-send'),
      closeB = document.getElementById('fr-close'),
      open   = false, greeted = false, busy = false;

  function esc(s){
    return (s==null?'':String(s)).replace(/[&<>"']/g,function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  function renderAnswer(text){
    function inline(s){
      var h = esc(s);
      h = h.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>');
      h = h.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>');
      h = h.replace(/(^|[^">])(https?:\/\/[^\s<)]+)/g,'$1<a href="$2" target="_blank" rel="noopener">$2</a>');
      return h;
    }
    var out=[], li=[];
    function flush(){ if(li.length){ out.push('<ul class="fr-list">'+li.join('')+'</ul>'); li=[]; } }
    text.split('\n').forEach(function(raw){
      var line = raw.replace(/\s+$/,''), m = line.match(/^\s*[-*•]\s+(.*)$/);
      if(m){ li.push('<li>'+inline(m[1])+'</li>'); }
      else { flush(); if(line.trim()) out.push('<p>'+inline(line)+'</p>'); }
    });
    flush();
    return out.join('');
  }

  function bubble(cls, html){
    var d = document.createElement('div');
    d.className = 'fr-b ' + cls;
    d.innerHTML = html;
    thread.appendChild(d);
    thread.scrollTop = thread.scrollHeight;
    return d;
  }

  function buildChips(){
    chips.innerHTML = '';
    CHIPS.forEach(function(c){
      var b = document.createElement('button');
      b.type = 'button'; b.textContent = c;
      b.onclick = function(){ input.value = c; send(); };
      chips.appendChild(b);
    });
  }

  function setOpen(v){
    open = v;
    panel.classList.toggle('fr-on', v);
    launch.classList.toggle('fr-open', v);
    document.body.classList.toggle('fr-split', v);          // <- pushes the page over
    launch.setAttribute('aria-label', v ? 'Close FundRadar chat' : 'Open FundRadar chat');
    if(v){
      launch.classList.add('fr-seen');
      if(!greeted){ greeted = true; bubble('a', renderAnswer(GREET)); }
      setTimeout(function(){ input.focus(); }, 220);
      thread.scrollTop = thread.scrollHeight;
    }
  }

  async function send(){
    if(busy) return;
    var q = input.value.trim();
    if(!q) return;
    input.value = '';
    busy = true; sendB.disabled = true;
    chips.style.display = 'none';
    bubble('q', esc(q));
    var bot = bubble('a fr-typing', '<i></i><i></i><i></i>');
    try{
      var r = await fetch('/chat?q=' + encodeURIComponent(q));
      var d = await r.json();
      bot.className = 'fr-b a';
      bot.innerHTML = renderAnswer(d.answer || '(no answer)');
    }catch(e){
      bot.className = 'fr-b a';
      bot.textContent = 'Could not reach the chatbot. Is the server running?';
    }
    busy = false; sendB.disabled = false;
    thread.scrollTop = thread.scrollHeight;
    input.focus();
  }

  /* --- drag the left edge to make the rail wider or narrower --- */
  (function(){
    var dragging = false;
    function width(px){
      var w = Math.max(300, Math.min(window.innerWidth * 0.6, px));
      document.documentElement.style.setProperty('--fr-rail', w + 'px');
    }
    grip.addEventListener('mousedown', function(e){
      dragging = true; grip.classList.add('fr-drag');
      document.body.style.userSelect = 'none';
      panel.style.transition = 'none';
      e.preventDefault();
    });
    window.addEventListener('mousemove', function(e){
      if(dragging) width(window.innerWidth - e.clientX);
    });
    window.addEventListener('mouseup', function(){
      if(!dragging) return;
      dragging = false; grip.classList.remove('fr-drag');
      document.body.style.userSelect = '';
      panel.style.transition = '';
    });
  })();

  launch.onclick = function(){ setOpen(!open); };
  closeB.onclick = function(){ setOpen(false); };
  sendB.onclick  = send;
  input.addEventListener('keydown', function(e){ if(e.key === 'Enter') send(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && open) setOpen(false); });

  buildChips();
  window.ask = function(t){ input.value = t; setOpen(true); send(); };
  window.openFundRadarChat = function(){ setOpen(true); };
})();
</script>
<!-- FR-BLOCK:chat END -->
<!-- FR-BLOCK:filters START -->
<!-- FundRadar - filters, amount range and switchable segmentation.
     Installed by INSTALL_FUNDRADAR_UI.bat - re-run it to upgrade.
     Takes over rendering of the Opportunities view; the Agencies view is
     left to the dashboard's original code. -->
<style>
  #statusFilter,#countryFilter{display:none!important}

  .fx{background:#fff;border:1px solid var(--line);border-radius:14px;margin-bottom:16px;
    box-shadow:var(--shadow);overflow:hidden}
  .fx-head{display:flex;align-items:center;gap:11px;padding:11px 15px;border-bottom:1px solid var(--line);
    background:#f8fbff;flex-wrap:wrap}
  .fx-head .ic{width:30px;height:30px;border-radius:9px;flex:0 0 auto;display:grid;place-items:center;
    background:var(--brand-soft);color:var(--brand-d)}
  .fx-head b{font-size:13.5px;font-weight:700}
  .fx-head small{display:block;font-size:11px;color:var(--muted);font-weight:500}
  .fx-head .sp{flex:1}
  .fx-count{font-size:11.5px;color:var(--muted);white-space:nowrap}
  .fx-btn{padding:6px 12px;border-radius:9px;font-size:11.5px;font-weight:700;cursor:pointer;
    border:1px solid var(--line);background:#fff;color:var(--ink);transition:.15s;white-space:nowrap}
  .fx-btn:hover:not(:disabled){border-color:#cdd9e8;box-shadow:var(--shadow)}
  .fx-btn:disabled{opacity:.4;cursor:not-allowed}

  /* segmentation selector, sitting in the header */
  .fx-seg{display:flex;align-items:center;gap:7px;padding:5px 6px 5px 11px;border-radius:10px;
    background:var(--brand-soft);border:1px solid #dbe6ff}
  .fx-seg span{font-size:10px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--brand-d)}
  .fx-seg select{border:none;background:#fff;border-radius:7px;padding:5px 8px;font-size:12px;
    font-weight:700;color:var(--brand-d);cursor:pointer;outline:none;font-family:inherit}

  /* fund-size preset chips */
  .fx-tiers{display:flex;flex-wrap:wrap;gap:8px;padding:13px 15px 3px}
  .fx-tier{display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:999px;cursor:pointer;
    font-size:12px;font-weight:700;border:1px solid var(--line);background:#fff;color:var(--ink);transition:.15s}
  .fx-tier:hover{transform:translateY(-1px);box-shadow:var(--shadow)}
  .fx-tier .sw{width:9px;height:9px;border-radius:50%;flex:0 0 auto}
  .fx-tier .n{font-size:11px;font-weight:700;padding:1px 7px;border-radius:999px;background:#eef2f7;color:var(--muted)}
  .fx-tier.on{color:#fff;border-color:transparent}
  .fx-tier.on .n{background:rgba(255,255,255,.25);color:#fff}
  .fx-tier.on .sw{background:#fff!important}

  .fx-grid{display:grid;gap:11px;padding:13px 15px;grid-template-columns:repeat(auto-fit,minmax(158px,1fr))}
  .fx-grid label{display:block;font-size:10px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;
    color:var(--muted);margin-bottom:5px}
  .fx-grid select{width:100%;padding:8px 10px;font-size:12.5px;border:1px solid var(--line);border-radius:9px;
    background:#fff;color:var(--ink);outline:none;font-family:inherit;cursor:pointer}
  .fx-grid select:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(37,99,235,.12)}
  .fx-range{display:flex;align-items:center;gap:6px}
  .fx-range select{flex:1;min-width:0}
  .fx-range i{font-style:normal;font-size:11px;color:var(--muted);font-weight:700}

  .fx-active{display:flex;flex-wrap:wrap;align-items:center;gap:7px;padding:0 15px 13px}
  .fx-active .lb{font-size:10px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--muted)}
  .fx-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 6px 4px 11px;border-radius:999px;
    font-size:11.5px;font-weight:600;background:var(--brand-soft);color:var(--brand-d);border:1px solid #dbe6ff}
  .fx-pill i{font-style:normal;opacity:.65;font-weight:500}
  .fx-pill button{width:17px;height:17px;border:none;border-radius:50%;cursor:pointer;line-height:1;
    background:transparent;color:inherit;font-size:13px;display:grid;place-items:center}
  .fx-pill button:hover{background:#cfe0ff}

  .fx-sz{display:block;width:fit-content;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:800;
    letter-spacing:.3px;text-transform:uppercase;color:#fff;margin-top:5px}
  .fx-yr{display:block;font-size:10.5px;color:var(--muted);margin-top:2px}

  /* segments */
  .fx-group{margin-bottom:20px}
  .fx-ghead{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:11px;margin-bottom:9px;
    background:#f5f9fd;border:1px solid var(--line);cursor:pointer;user-select:none}
  .fx-ghead:hover{background:#eef5fc}
  .fx-ghead .sw{width:11px;height:11px;border-radius:50%;flex:0 0 auto}
  .fx-ghead b{font-size:13.5px}
  .fx-ghead small{font-size:11.5px;color:var(--muted)}
  .fx-ghead .sp{flex:1}
  .fx-ghead .car{font-size:11px;color:var(--muted);transition:transform .18s}
  .fx-group.fx-shut .car{transform:rotate(-90deg)}
  .fx-group.fx-shut .fx-gbody{display:none}
  .fx-note{padding:10px 15px;font-size:11.5px;color:var(--muted);border-top:1px solid var(--line);background:#fcfdff}
  #table th:nth-child(2){width:32%}
  #table td.amt{min-width:150px}
  @media (max-width:640px){ .fx-grid{grid-template-columns:repeat(auto-fit,minmax(140px,1fr))} }
</style>

<script>
(function(){
"use strict";
if (typeof OPP === 'undefined' || typeof render !== 'function') return;   // not the dashboard page

/* ============================ fund-size engine ============================ *
 * Mirrors app/core/fundsize.py. Rates are approximate and used ONLY to decide
 * which bucket something falls into - never for display.                    */
var FX_TO_INR = {INR:1, USD:88, EUR:96, GBP:112, CHF:100, JPY:0.58,
                 AUD:58, CAD:64, SGD:66, SEK:8.4, NOK:8.3, DKK:12.9, AED:24};

var CUR_TOKENS = [['₹','INR'],['rs.','INR'],['rs ','INR'],['inr','INR'],['rupee','INR'],
                  ['us$','USD'],['usd','USD'],['$','USD'],['€','EUR'],['eur','EUR'],
                  ['£','GBP'],['gbp','GBP'],['chf','CHF'],['sfr','CHF'],['¥','JPY'],['jpy','JPY'],
                  ['aud','AUD'],['cad','CAD'],['sgd','SGD'],['sek','SEK'],['nok','NOK'],
                  ['dkk','DKK'],['aed','AED']];
var MULT = {lakh:1e5,lakhs:1e5,lac:1e5,lacs:1e5, crore:1e7,crores:1e7,cr:1e7,
            k:1e3,thousand:1e3, m:1e6,mn:1e6,million:1e6, b:1e9,bn:1e9,billion:1e9};

var TIERS = [
  {k:'small',  label:'Small',       color:'#0891b2', lo:0,   hi:5e5,      hint:'under ₹5 lakh / yr'},
  {k:'medium', label:'Medium',      color:'#059669', lo:5e5, hi:5e6,      hint:'₹5 lakh – ₹50 lakh / yr'},
  {k:'large',  label:'Large',       color:'#2563eb', lo:5e6, hi:5e7,      hint:'₹50 lakh – ₹5 crore / yr'},
  {k:'xlarge', label:'Extra Large', color:'#7c3aed', lo:5e7, hi:Infinity, hint:'over ₹5 crore / yr'}
];
var TIER_BY = {}; TIERS.forEach(function(t){ TIER_BY[t.k]=t; });
TIER_BY.unknown = {k:'unknown', label:'Not specified', color:'#94a3b8', hint:'no amount published'};
var TIER_KEYS = ['small','medium','large','xlarge','unknown'];

function detectCur(text){
  var low = ' ' + text.toLowerCase().replace(/,/g,'') + ' ';
  for (var i=0;i<CUR_TOKENS.length;i++) if (low.indexOf(CUR_TOKENS[i][0]) !== -1) return CUR_TOKENS[i][1];
  return null;
}
function firstNumber(low){
  var m = low.match(/\d{1,3}(?:\.\d{3})+(?!\d)/);        // European 3.000 = 3000
  if (m) return parseFloat(m[0].replace(/\./g,''));
  m = low.replace(/,/g,'').match(/\d+(?:\.\d+)?/);
  return m ? parseFloat(m[0]) : null;
}
function parseAmount(text){
  var blank = {value:null, currency:null, perYearInr:null, tier:'unknown', monthly:false};
  if (!text) return blank;
  var raw = String(text).trim();
  if (!raw) return blank;

  var currency = detectCur(raw);
  var low = raw.toLowerCase().replace(/\/-/g,' ');

  var unit = null, words = Object.keys(MULT).sort(function(a,b){return b.length-a.length;});
  for (var i=0;i<words.length;i++){
    if (new RegExp('\\b'+words[i]+'\\b').test(low)) { unit = words[i]; break; }
  }
  if (currency === null && unit === null) return blank;   // digits are noise ("J-1 visa")

  var value = firstNumber(low);
  if (value === null || value <= 0) return blank;
  if (unit) value *= MULT[unit];

  var factor = 1, monthly = false;
  if (/per\s*month|\/\s*month|monthly|\bp\.?m\.?\b|a\s*month/.test(low))      { factor = 12; monthly = true; }
  else if (/per\s*week|\/\s*week|weekly/.test(low))                           { factor = 52; monthly = true; }

  var perYear = value * factor;
  if (currency && FX_TO_INR[currency]) perYear *= FX_TO_INR[currency];
  else if (currency === null) perYear = null;

  var tier = 'unknown';
  if (perYear !== null) {
    for (var j=0;j<TIERS.length;j++) if (perYear >= TIERS[j].lo && perYear < TIERS[j].hi) { tier = TIERS[j].k; break; }
  }
  return {value:value, currency:currency, perYearInr:perYear, tier:tier, monthly:monthly};
}
/* Trust the published text. amount_value is only used when there is no text,
   because that column was filled by the older parser and holds junk like 1.0. */
function sizeOf(o){
  if (o.funding_amount) return parseAmount(o.funding_amount);
  var v = Number(o.amount_value);
  if (!v || v < 1000) return {value:null, currency:null, perYearInr:null, tier:'unknown', monthly:false};
  return parseAmount((o.currency || 'INR') + ' ' + v);
}
function inrShort(v){
  if (v == null) return '';
  if (v >= 1e7) return '≈ ₹' + (v/1e7).toFixed(v >= 1e8 ? 0 : 2).replace(/\.00$/,'') + ' cr/yr';
  if (v >= 1e5) return '≈ ₹' + (v/1e5).toFixed(v >= 1e6 ? 0 : 1).replace(/\.0$/,'') + ' lakh/yr';
  return '≈ ₹' + Math.round(v).toLocaleString('en-IN') + '/yr';
}

/* ============================== funder type ============================== */
function sectorOf(agency){
  var s = [(agency && agency.funding_type) || '', (agency && agency.category) || ''].join(' ').toLowerCase();
  if (/government|public sector|ministry|state/.test(s))          return 'government';
  if (/universit|academ|college|institut/.test(s))                return 'university';
  if (/foundation|ngo|charit|trust|philanthrop/.test(s))          return 'foundation';
  if (/bilateral|multilateral|international/.test(s))             return 'international';
  if (/private|industr|corporate|public-private|company/.test(s)) return 'private';
  return 'other';
}
var SECTORS = {
  government:   {label:'Government',            color:'#2563eb', hint:'national & state agencies'},
  university:   {label:'University & Academic', color:'#7c3aed', hint:'universities, academies, institutes'},
  foundation:   {label:'Foundation & NGO',      color:'#059669', hint:'philanthropic and non-profit funders'},
  international:{label:'International',         color:'#0891b2', hint:'bilateral & multilateral programmes'},
  private:      {label:'Private & Industry',    color:'#ea580c', hint:'corporate and public-private funding'},
  other:        {label:'Other',                 color:'#94a3b8', hint:'not classified'}
};
var SECTOR_ORDER = ['government','university','foundation','international','private','other'];

/* ============================ filters & state ============================ */
var AMT_STEPS = [
  ['1e5','₹1 lakh'], ['5e5','₹5 lakh'], ['1e6','₹10 lakh'], ['5e6','₹50 lakh'],
  ['1e7','₹1 crore'], ['5e7','₹5 crore'], ['1e8','₹10 crore'], ['5e8','₹50 crore']
];
var DEF = {size:'all', min:'', max:'', deadline:'', status:'', country:'', agency:'',
           sector:'', area:'', type:'', elig:'', sort:'best', seg:'size'};
var F = Object.assign({}, DEF);
var SHUT = {};                                    // collapsed segments

var TYPES = [['fellowship','Fellowship'],['scholarship','Scholarship'],['grant','Grant'],
             ['award','Award / Prize'],['internship','Internship'],['programme','Programme']];
var ELIGS = [['phd','PhD student'],['postdoc','Postdoc / early career'],['faculty','Faculty / researcher'],
             ['student','Student'],['startup','Startup / company'],['institution','Institution']];
var SORTS = [['best','Best matches first'],['amount_desc','Fund size — high to low'],
             ['amount_asc','Fund size — low to high'],['deadline_asc','Deadline — soonest first'],
             ['deadline_desc','Deadline — latest first'],['name_asc','Programme — A → Z'],
             ['agency_asc','Agency — A → Z']];
var SEGMENTS = [['none','No segments — one list'],['size','Fund size'],['sector','Funder type'],
                ['country','Country'],['area','Research area'],['type','Opportunity type'],
                ['agency','Agency'],['status','Status'],['deadline','Deadline window']];
var LABELS = {size:'Fund size',min:'Amount from',max:'Amount up to',deadline:'Deadline',status:'Status',
              country:'Country',agency:'Agency',sector:'Funder type',area:'Research area',
              type:'Type',elig:'Eligibility'};

function typeOf(o){
  var s = [o.program_name, o.tags, o.research_area].join(' ').toLowerCase();
  if (/fellowship/.test(s))                return 'fellowship';
  if (/scholarship|studentship/.test(s))   return 'scholarship';
  if (/internship|traineeship/.test(s))    return 'internship';
  if (/\bprize\b|\baward\b|medal/.test(s)) return 'award';
  if (/grant|funding|call for proposal/.test(s)) return 'grant';
  return 'programme';
}
function eligOf(o){
  var s = [o.eligibility, o.program_name, o.tags].join(' ').toLowerCase(), out = [];
  if (/ph\.?d|doctoral|doctorate/.test(s))                           out.push('phd');
  if (/post-?doc|early career|early-career/.test(s))                 out.push('postdoc');
  if (/faculty|professor|scientist|researcher|investigator/.test(s)) out.push('faculty');
  if (/student|undergrad|graduate|master/.test(s))                   out.push('student');
  if (/start-?up|compan|industr|entrepreneur|sme\b/.test(s))         out.push('startup');
  if (/institut|universit|college|organis|organiz/.test(s))          out.push('institution');
  return out;
}
function daysTo(d){
  if (!d) return null;
  var dt = new Date(d); if (isNaN(dt)) return null;
  var today = new Date(); today.setHours(0,0,0,0);
  return Math.round((dt - today) / 86400000);
}
function windowOf(o){
  var n = daysTo(o.deadline);
  if (n === null) return 'rolling';
  if (n < 0)   return 'past';
  if (n <= 7)  return 'week';
  if (n <= 31) return 'month';
  if (n <= 92) return 'q';
  return 'later';
}
var WINDOWS = {week:{label:'Closing within 7 days',color:'#dc2626'},
               month:{label:'Closing within 30 days',color:'#ea580c'},
               q:{label:'Closing within 3 months',color:'#2563eb'},
               later:{label:'More than 3 months away',color:'#059669'},
               rolling:{label:'Rolling / no fixed date',color:'#0891b2'},
               past:{label:'Already closed',color:'#94a3b8'}};
var WINDOW_ORDER = ['week','month','q','later','rolling','past'];

/* The dashboard's AGMAP keeps only {name,country,code}, so funding_type is not
   in it. Build a full index straight off AG, which holds the whole records. */
function agencyIndex(){
  var ix = {};
  (typeof AG !== 'undefined' ? AG : []).forEach(function(a){ ix[a.id] = a; });
  return ix;
}
function decorate(){
  var IX = agencyIndex();
  return OPP.map(function(o){
    var ag = IX[o.agency_id] || AGMAP[o.agency_id] || {}, sz = sizeOf(o);
    return Object.assign({}, o, {
      agency: ag.name || '', country: ag.country || '',
      _tier: sz.tier, _inr: sz.perYearInr, _monthly: sz.monthly,
      _sector: sectorOf(ag), _type: typeOf(o), _elig: eligOf(o), _win: windowOf(o)
    });
  });
}
function inRange(o){
  if (!F.min && !F.max) return true;
  if (o._inr == null) return false;                        // no amount -> cannot be in a range
  if (F.min && o._inr <  parseFloat(F.min)) return false;
  if (F.max && o._inr >= parseFloat(F.max)) return false;
  return true;
}
function applyFilters(rows, ignore){
  var q = (document.getElementById('search') || {value:''}).value.toLowerCase();
  return rows.filter(function(o){
    if (q && [o.program_name,o.agency,o.research_area,o.tags,o.funding_amount].join(' ').toLowerCase().indexOf(q) === -1) return false;
    if (ignore !== 'size' && F.size !== 'all' && o._tier !== F.size) return false;
    if (ignore !== 'size' && !inRange(o))       return false;
    if (F.status   && o.status !== F.status)    return false;
    if (F.country  && o.country !== F.country)  return false;
    if (F.agency   && o.agency !== F.agency)    return false;
    if (F.sector   && o._sector !== F.sector)   return false;
    if (F.area     && o.research_area !== F.area) return false;
    if (F.type     && o._type !== F.type)       return false;
    if (F.elig     && o._elig.indexOf(F.elig) === -1) return false;
    if (F.deadline && o._win !== F.deadline)    return false;
    return true;
  });
}
function sortRows(rows){
  var s = F.sort,
      num = function(v){ return v == null ? -1 : v; },
      dl  = function(o){ return String(o.deadline || '9999-99-99'); };
  if (s === 'amount_desc')        rows.sort(function(a,b){ return num(b._inr) - num(a._inr); });
  else if (s === 'amount_asc')    rows.sort(function(a,b){ return (a._inr==null?1:0)-(b._inr==null?1:0) || num(a._inr)-num(b._inr); });
  else if (s === 'deadline_asc')  rows.sort(function(a,b){ return dl(a).localeCompare(dl(b)); });
  else if (s === 'deadline_desc') rows.sort(function(a,b){ return dl(b).localeCompare(dl(a)); });
  else if (s === 'name_asc')      rows.sort(function(a,b){ return String(a.program_name||'').localeCompare(String(b.program_name||'')); });
  else if (s === 'agency_asc')    rows.sort(function(a,b){ return String(a.agency||'').localeCompare(String(b.agency||'')); });
  else rows.sort(function(a,b){
    var comp = function(o){ return ((o._inr!=null||o.funding_amount)?1:0) + (o.deadline?1:0); };
    return comp(b)-comp(a) || (a.status==='open'?0:1)-(b.status==='open'?0:1) || dl(a).localeCompare(dl(b));
  });
  return rows;
}

/* ============================== segmentation ============================= */
var PALETTE = ['#2563eb','#059669','#7c3aed','#ea580c','#0891b2','#db2777','#4f46e5','#0d9488',
               '#b45309','#be123c','#15803d','#6d28d9'];

/* -> [{key,label,hint,color,rows}] in a sensible order, empty segments dropped */
function segmentsOf(rows, key){
  if (key === 'none') return [{key:'all', label:'', hint:'', color:'', rows:rows}];

  function fixed(order, meta, pick){
    return order.map(function(k){
      return {key:k, label:meta[k].label, hint:meta[k].hint || '', color:meta[k].color,
              rows:rows.filter(function(o){ return pick(o) === k; })};
    }).filter(function(g){ return g.rows.length; });
  }
  if (key === 'size'){
    var order = ['xlarge','large','medium','small','unknown'];
    return order.map(function(k){
      var t = TIER_BY[k];
      return {key:k, label:(k==='unknown'?'Amount not specified':t.label+' funds'), hint:t.hint,
              color:t.color, rows:rows.filter(function(o){ return o._tier === k; })};
    }).filter(function(g){ return g.rows.length; });
  }
  if (key === 'sector')   return fixed(SECTOR_ORDER, SECTORS, function(o){ return o._sector; });
  if (key === 'deadline') return fixed(WINDOW_ORDER, WINDOWS, function(o){ return o._win; });
  if (key === 'type'){
    var meta = {}; TYPES.forEach(function(p,i){ meta[p[0]] = {label:p[1], color:PALETTE[i%PALETTE.length]}; });
    return fixed(TYPES.map(function(p){return p[0];}), meta, function(o){ return o._type; });
  }

  /* free-text fields: biggest group first */
  var field = key === 'country' ? 'country' : key === 'area' ? 'research_area' : key === 'agency' ? 'agency' : 'status';
  var map = {};
  rows.forEach(function(o){
    var v = (o[field] == null || o[field] === '') ? '—' : String(o[field]);
    (map[v] = map[v] || []).push(o);
  });
  return Object.keys(map).sort(function(a,b){ return map[b].length - map[a].length || a.localeCompare(b); })
    .map(function(v,i){
      return {key:v, label:(v === '—' ? 'Not specified' : v), hint:'', color:PALETTE[i % PALETTE.length], rows:map[v]};
    });
}

/* ================================== UI =================================== */
function escH(s){ return (s==null?'':String(s)).replace(/[&<>"']/g,function(c){
  return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function escA(s){ return String(s).replace(/"/g,'&quot;'); }
function uniqSorted(list){ return list.filter(function(v,i,a){ return v && a.indexOf(v) === i; }).sort(); }
function pair(v){ return [v, v]; }

function buildPanel(){
  if (document.getElementById('fxPanel')) return;
  var host = document.querySelector('.panel');
  if (!host || !host.parentNode) return;
  var el = document.createElement('section');
  el.className = 'fx'; el.id = 'fxPanel';
  el.innerHTML =
    '<div class="fx-head">' +
      '<div class="ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
        'stroke-width="2" stroke-linecap="round"><path d="M3 5h18M6 12h12M10 19h4"/></svg></div>' +
      '<div><b>Filter &amp; segment opportunities</b><small id="fxSub"></small></div>' +
      '<span class="sp"></span>' +
      '<label class="fx-seg"><span>Segment by</span><select id="fxSeg">' +
        SEGMENTS.map(function(p){ return '<option value="'+p[0]+'">'+p[1]+'</option>'; }).join('') +
      '</select></label>' +
      '<span class="fx-count" id="fxCount"></span>' +
      '<button class="fx-btn" id="fxClear">Clear all</button>' +
    '</div>' +
    '<div class="fx-tiers" id="fxTiers"></div>' +
    '<div class="fx-grid" id="fxGrid"></div>' +
    '<div class="fx-active" id="fxActive" style="display:none"></div>' +
    '<div class="fx-note" id="fxNote"></div>';
  host.parentNode.insertBefore(el, host);

  document.getElementById('fxClear').onclick = function(){
    var seg = F.seg; F = Object.assign({}, DEF); F.seg = seg; render();
  };
  document.getElementById('fxSeg').onchange = function(){ F.seg = this.value; SHUT = {}; render(); };
}

function sel(key, blank, opts){
  var o = ['<option value="">' + blank + '</option>'];
  opts.forEach(function(p){
    o.push('<option value="' + escA(p[0]) + '"' + (F[key] === p[0] ? ' selected' : '') + '>' + escH(p[1]) + '</option>');
  });
  return '<div><label for="fx-' + key + '">' + LABELS[key] + '</label>' +
         '<select id="fx-' + key + '" data-k="' + key + '">' + o.join('') + '</select></div>';
}
function rangeField(){
  var opt = function(k, blank){
    return '<select id="fx-' + k + '" data-k="' + k + '"><option value="">' + blank + '</option>' +
      AMT_STEPS.map(function(p){ return '<option value="'+p[0]+'"'+(F[k]===p[0]?' selected':'')+'>'+p[1]+'</option>'; }).join('') +
      '</select>';
  };
  return '<div style="grid-column:span 2"><label>Amount range (per year, in ₹)</label>' +
         '<div class="fx-range">' + opt('min','No minimum') + '<i>to</i>' + opt('max','No maximum') + '</div></div>';
}

function drawControls(all){
  var base = applyFilters(all, 'size');
  var counts = {all: base.length};
  TIER_KEYS.forEach(function(k){ counts[k] = base.filter(function(o){ return o._tier === k; }).length; });

  var chips = ['<button class="fx-tier' + (F.size==='all'&&!F.min&&!F.max?' on':'') + '" data-t="all" ' +
               'style="' + (F.size==='all'&&!F.min&&!F.max?'background:#334155;':'') + '">' +
               '<span class="sw" style="background:#334155"></span>All sizes<span class="n">' + counts.all + '</span></button>'];
  TIER_KEYS.forEach(function(k){
    var t = TIER_BY[k], on = F.size === k;
    chips.push('<button class="fx-tier' + (on?' on':'') + '" data-t="' + k + '" title="' + t.hint + '"' +
      (on ? ' style="background:' + t.color + '"' : '') + '>' +
      '<span class="sw" style="background:' + t.color + '"></span>' + t.label +
      '<span class="n">' + counts[k] + '</span></button>');
  });
  var tiers = document.getElementById('fxTiers');
  tiers.innerHTML = chips.join('');
  Array.prototype.forEach.call(tiers.children, function(b){
    b.onclick = function(){
      F.size = (F.size === b.dataset.t) ? 'all' : b.dataset.t;
      F.min = ''; F.max = '';                       // presets and custom range are exclusive
      render();
    };
  });

  document.getElementById('fxGrid').innerHTML =
    rangeField() +
    sel('deadline','Any deadline', WINDOW_ORDER.map(function(k){ return [k, WINDOWS[k].label]; })) +
    sel('status','Any status',[['open','Open'],['closed','Closed'],['unknown','Rolling / unknown']]) +
    sel('sector','All funder types', SECTOR_ORDER.map(function(k){ return [k, SECTORS[k].label]; })) +
    sel('country','All countries', uniqSorted(all.map(function(o){return o.country;})).map(pair)) +
    sel('agency','All agencies',   uniqSorted(all.map(function(o){return o.agency;})).map(pair)) +
    sel('area','All research areas', uniqSorted(all.map(function(o){return o.research_area;})).map(pair)) +
    sel('type','All types', TYPES) +
    sel('elig','Anyone eligible', ELIGS) +
    '<div><label for="fx-sort">Sort inside each list</label><select id="fx-sort" data-k="sort">' +
      SORTS.map(function(p){ return '<option value="'+p[0]+'"'+(F.sort===p[0]?' selected':'')+'>'+p[1]+'</option>'; }).join('') +
    '</select></div>';
  Array.prototype.forEach.call(document.querySelectorAll('#fxGrid select'), function(s){
    s.onchange = function(){
      F[s.dataset.k] = s.value;
      if (s.dataset.k === 'min' || s.dataset.k === 'max') F.size = 'all';
      render();
    };
  });
  document.getElementById('fxSeg').value = F.seg;

  var sf = document.getElementById('statusFilter'), cf = document.getElementById('countryFilter');
  if (sf) sf.value = F.status;
  if (cf) cf.value = F.country;

  /* active pills */
  var order = ['size','min','max','deadline','status','sector','country','agency','area','type','elig'];
  var active = order.filter(function(k){ return k === 'size' ? F.size !== 'all' : !!F[k]; });
  var box = document.getElementById('fxActive');
  box.style.display = active.length ? '' : 'none';
  if (active.length){
    var lookup = function(list, v){ var hit = list.filter(function(p){ return p[0] === v; })[0]; return hit ? hit[1] : v; };
    box.innerHTML = '<span class="lb">Active</span>' + active.map(function(k){
      var v = F[k], text =
          k === 'size'     ? TIER_BY[v].label
        : k === 'min' || k === 'max' ? lookup(AMT_STEPS, v)
        : k === 'type'     ? lookup(TYPES, v)
        : k === 'elig'     ? lookup(ELIGS, v)
        : k === 'sector'   ? SECTORS[v].label
        : k === 'deadline' ? WINDOWS[v].label
        : v;
      return '<span class="fx-pill"><i>' + LABELS[k] + ':</i> ' + escH(text) +
             '<button data-k="' + k + '" title="Remove">&times;</button></span>';
    }).join('');
    Array.prototype.forEach.call(box.querySelectorAll('button'), function(b){
      b.onclick = function(){ F[b.dataset.k] = DEF[b.dataset.k]; render(); };
    });
  }

  var anyOn = active.length > 0 || F.sort !== DEF.sort;
  document.getElementById('fxClear').disabled = !anyOn;
  return counts;
}

/* ---------------------------- table rendering ---------------------------- */
function table(rows, showSize){
  var head = '<thead><tr><th style="width:34px" title="Saved"></th>' +
    '<th>Programme</th><th>Agency</th><th>Country</th><th>Amount</th><th>Deadline</th><th>Status</th></tr></thead>';
  var body = rows.map(function(o){
    var t = TIER_BY[o._tier];
    var amt = o.funding_amount ? escH(String(o.funding_amount).slice(0,46))
            : (o.amount_value ? escH((o.currency||'') + ' ' + Number(o.amount_value).toLocaleString()) : '<span class="muted">—</span>');
    return '<tr class="orow" onclick="openOpp(' + o.id + ')" title="Click for full details">' +
      '<td><button class="star ' + (SAVED.has(o.id)?'on':'') + '" onclick="event.stopPropagation();toggleSave(' + o.id + ',this)">★</button></td>' +
      '<td class="prog">' + (o.program_name ? escH(o.program_name) : '<span class="muted">Untitled scheme</span>') +
        (o.research_area ? '<div class="area">' + escH(o.research_area) + '</div>' : '') +
        (o.application_link ? '<div class="apply"><a href="' + escA(o.application_link) + '" target="_blank" rel="noopener" onclick="event.stopPropagation()">Apply / details ↗</a></div>' : '') +
      '</td>' +
      '<td>' + agencyCell(o.agency) + '</td>' +
      '<td>' + (o.country ? escH(o.country) : '<span class="muted">—</span>') + '</td>' +
      '<td class="amt ' + (o._inr!=null?'has':'') + '">' + amt +
        (showSize ? '<span class="fx-sz" style="background:' + t.color + '">' + t.label + '</span>' : '') +
        (o._inr != null ? '<span class="fx-yr">' + inrShort(o._inr) + (o._monthly ? ' (from a monthly figure)' : '') + '</span>' : '') +
      '</td>' +
      '<td>' + fmtDate(o.deadline) + '</td>' +
      '<td>' + badge(o.status) + '</td></tr>';
  }).join('');
  return '<table>' + head + '<tbody>' + body + '</tbody></table>';
}

function drawSegments(groups){
  var el = document.getElementById('table');
  if (groups.length === 1 && groups[0].key === 'all'){
    el.innerHTML = table(groups[0].rows, true);
    return;
  }
  el.innerHTML = groups.map(function(g){
    var shut = SHUT[F.seg + '::' + g.key];
    return '<div class="fx-group' + (shut ? ' fx-shut' : '') + '" data-g="' + escA(g.key) + '">' +
      '<div class="fx-ghead"><span class="car">▼</span>' +
        '<span class="sw" style="background:' + g.color + '"></span>' +
        '<b>' + escH(g.label) + '</b>' + (g.hint ? '<small>' + escH(g.hint) + '</small>' : '') +
        '<span class="sp"></span>' +
        '<small><b>' + g.rows.length + '</b> opportunit' + (g.rows.length === 1 ? 'y' : 'ies') + '</small>' +
      '</div><div class="fx-gbody">' + table(g.rows, F.seg !== 'size') + '</div></div>';
  }).join('');
  Array.prototype.forEach.call(el.querySelectorAll('.fx-ghead'), function(h){
    h.onclick = function(){
      var wrap = h.parentNode, k = F.seg + '::' + wrap.dataset.g;
      SHUT[k] = !SHUT[k];
      wrap.classList.toggle('fx-shut', SHUT[k]);
    };
  });
}

/* ------------------------------ the override ----------------------------- */
var originalRender = render;

window.render = function(){
  var panel = document.getElementById('fxPanel');
  if (view !== 'opps'){
    if (panel) panel.style.display = 'none';
    var cf = document.getElementById('countryFilter');
    if (cf) cf.value = F.country;
    return originalRender.apply(this, arguments);
  }
  buildPanel();
  panel = document.getElementById('fxPanel');
  if (panel) panel.style.display = '';

  var all    = decorate();
  var counts = drawControls(all);
  var rows   = sortRows(applyFilters(all));

  if (!rows.length){
    document.getElementById('table').innerHTML = '<div class="empty">No opportunities match these filters.</div>';
  } else {
    drawSegments(segmentsOf(rows, F.seg));
  }

  var segName = (SEGMENTS.filter(function(p){ return p[0] === F.seg; })[0] || [,''])[1];
  document.getElementById('fxCount').textContent = rows.length + ' of ' + all.length + ' shown';
  document.getElementById('fxSub').textContent =
    F.seg === 'none' ? 'One combined list.' : 'Split into segments by ' + segName.toLowerCase() + '.';
  var pct = counts.all ? Math.round(100 * counts.unknown / counts.all) : 0;
  document.getElementById('fxNote').innerHTML =
    'Fund size is worked out from the published amount — monthly stipends are scaled to a yearly figure and ' +
    'non-INR amounts are converted at approximate rates, for bucketing only. ' +
    '<b>' + counts.unknown + '</b> of the ' + counts.all + ' matching (' + pct +
    '%) publish no usable amount, so they sit in “Not specified” and never fall inside an amount range.';

  if (typeof foot === 'function') foot(rows.length);
};
})();
</script>
<!-- FR-BLOCK:filters END -->
</body>
</html>
